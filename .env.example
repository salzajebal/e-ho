# Required in Render and any non-Replit deployment.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string

# Replit에서 기존 DB를 Supabase로 이전할 때만 사용합니다.
# Render에는 이 키 대신 DATABASE_URL을 등록합니다.
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Optional: used only to create the first administrator in an empty database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: Supabase TLS is detected automatically from DATABASE_URL.
# DATABASE_SSL=true
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Backup imports are disabled by default. Do not enable in a deployed environment.
# SEED_FROM_BACKUP=false

# Keep false unless a GitHub token and pg_dump are deliberately configured.
ENABLE_GIT_BACKUPS=false
# GITHUB_TOKEN=