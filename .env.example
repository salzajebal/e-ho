# Required in Render and any non-Replit deployment.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string

# Optional: used only to create the first administrator in an empty database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: Supabase SSL is detected automatically from DATABASE_URL.
# DATABASE_SSL=true

# Backup imports are disabled by default. Do not enable in a deployed environment.
# SEED_FROM_BACKUP=false

# Keep false unless a GitHub token and pg_dump are deliberately configured.
ENABLE_GIT_BACKUPS=false
# GITHUB_TOKEN=