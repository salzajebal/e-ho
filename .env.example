# Required in production. Lightsail uses PostgreSQL on the same server.
DATABASE_URL=postgresql://eho_app:[URL_ENCODED_PASSWORD]@localhost:5432/myapp
SESSION_SECRET=replace-with-a-long-random-string

# AWS Lightsail production defaults.
NODE_ENV=production
PORT=3000
ENABLE_GIT_BACKUPS=false

# 기존 Supabase 등에서 Lightsail 로컬 PostgreSQL로 데이터를 한 번 이전할 때만 사용합니다.
# SOURCE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# TARGET_DATABASE_URL=postgresql://eho_app:[URL_ENCODED_PASSWORD]@localhost:5432/myapp

# Optional: used only to create the first administrator in an empty database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: Supabase TLS is detected automatically from DATABASE_URL.
# DATABASE_SSL=true
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Backup imports are disabled by default. Do not enable in a deployed environment.
# SEED_FROM_BACKUP=false